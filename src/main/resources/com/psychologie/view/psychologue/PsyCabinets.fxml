<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.psychologie.controller.psychologue.PsyCabinetsController"
      style="-fx-background-color: #f8f9fa;">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Mes Cabinets" styleClass="label-header" style="-fx-font-size: 20;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Ajouter un cabinet" styleClass="btn-primary" onAction="#handleAddCabinet"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;"/>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="20">
            <Label text="Mes Cabinets liés" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <FlowPane fx:id="cabinetsContainer" hgap="20" vgap="20"/>
        </VBox>
    </ScrollPane>

</VBox>
