<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.psychologie.controller.admin.AdminWellbeingController"
      style="-fx-background-color: #f4f2ee;">
    
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Administration" styleClass="label-header" style="-fx-font-size: 18;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="10 May 2026" styleClass="stat-label-admin"/>
    </HBox>

    <VBox spacing="10">
        <Label text="Programmes bien-etre" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        <Label text="Supervision des programmes, activites et avis associes." style="-fx-text-fill: #7f8c8d;"/>
    </VBox>

    <!-- Stats Cards Row -->
    <HBox spacing="20">
        <VBox styleClass="stat-card-admin" HBox.hgrow="ALWAYS" prefWidth="200">
            <Label text="Programmes" styleClass="stat-label-admin"/>
            <Label fx:id="totalProgramsLabel" text="3" styleClass="stat-value-admin" style="-fx-text-fill: #2c3e50;"/>
        </VBox>
        <VBox styleClass="stat-card-admin" HBox.hgrow="ALWAYS" prefWidth="200">
            <Label text="Programmes actifs" styleClass="stat-label-admin"/>
            <Label fx:id="activeProgramsLabel" text="2" styleClass="stat-value-admin" style="-fx-text-fill: #2c3e50;"/>
        </VBox>
        <VBox styleClass="stat-card-admin" HBox.hgrow="ALWAYS" prefWidth="200">
            <Label text="Activites" styleClass="stat-label-admin"/>
            <Label fx:id="activitiesLabel" text="2" styleClass="stat-value-admin" style="-fx-text-fill: #2c3e50;"/>
        </VBox>
        <VBox styleClass="stat-card-admin" HBox.hgrow="ALWAYS" prefWidth="200">
            <Label text="Avis" styleClass="stat-label-admin"/>
            <Label fx:id="reviewsLabel" text="3" styleClass="stat-value-admin" style="-fx-text-fill: #2c3e50;"/>
        </VBox>
    </HBox>

    <HBox spacing="15" styleClass="stat-card-admin" style="-fx-padding: 15;">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Recherche" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;"/>
            <TextField fx:id="searchField" promptText="Nom programme, objectif, psychologue..." style="-fx-padding: 8;"/>
        </VBox>
        <VBox spacing="5" prefWidth="150">
            <Label text="Statut" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;"/>
            <ComboBox fx:id="statusFilter" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="5" prefWidth="150">
            <Label text="Niveau" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;"/>
            <ComboBox fx:id="levelFilter" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <VBox styleClass="stat-card-admin" VBox.vgrow="ALWAYS" style="-fx-padding: 0;">
        <TableView fx:id="programTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <columns>
                <TableColumn fx:id="idColumn" text="#" prefWidth="40"/>
                <TableColumn fx:id="programColumn" text="Programme" prefWidth="300"/>
                <TableColumn fx:id="psyColumn" text="Psychologue" prefWidth="200"/>
                <TableColumn fx:id="statusColumn" text="Statut" prefWidth="100"/>
                <TableColumn fx:id="levelColumn" text="Niveau" prefWidth="100"/>
                <TableColumn fx:id="activitiesCountColumn" text="Activites" prefWidth="80"/>
                <TableColumn fx:id="reviewsCountColumn" text="Avis" prefWidth="80"/>
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
