<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.psychologie.controller.admin.AdminCabinetController"
      style="-fx-background-color: #f4f2ee;">
    
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Gestion des Cabinets" styleClass="label-header" style="-fx-font-size: 18;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="dateLabel" text="10 May 2026" styleClass="stat-label-admin"/>
    </HBox>

    <VBox styleClass="stat-card-admin" VBox.vgrow="ALWAYS" style="-fx-padding: 0;">
        <TableView fx:id="cabinetTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <columns>
                <TableColumn fx:id="villeColumn" text="Ville" prefWidth="150"/>
                <TableColumn fx:id="adresseColumn" text="Adresse" prefWidth="250"/>
                <TableColumn fx:id="horairesColumn" text="Horaires" prefWidth="150"/>
                <TableColumn fx:id="statusColumn" text="Statut" prefWidth="120"/>
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="250"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
