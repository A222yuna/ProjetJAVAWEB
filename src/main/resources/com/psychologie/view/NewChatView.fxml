<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.psychologie.controller.NewChatController"
      style="-fx-background-color: #f4f2ee;">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button text="← Retour" onAction="#handleBack" styleClass="btn-secondary"/>
        <VBox spacing="5">
            <Label text="Nouvelle conversation" styleClass="label-header" style="-fx-font-size: 20;"/>
            <Label text="Sélectionnez un utilisateur pour commencer à discuter." styleClass="stat-label"/>
        </VBox>
    </HBox>

    <HBox spacing="10" styleClass="filter-bar">
        <TextField fx:id="searchField" promptText="Rechercher un nom ou email..." HBox.hgrow="ALWAYS" prefHeight="40"/>
        <Button text="Rechercher" styleClass="btn-primary" onAction="#handleSearch" prefHeight="40"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
        <FlowPane fx:id="userCardsContainer" hgap="20" vgap="20" prefWrapLength="800">
            <padding>
                <Insets bottom="20"/>
            </padding>
        </FlowPane>
    </ScrollPane>

</VBox>
