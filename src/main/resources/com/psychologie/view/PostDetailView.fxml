<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.psychologie.controller.PostDetailController"
            style="-fx-background-color: #f4f2ee; -fx-background: #f4f2ee;">
    
    <VBox spacing="20" style="-fx-background-color: #f4f2ee;">
        <padding>
            <Insets top="30" right="50" bottom="30" left="50"/>
        </padding>

        <!-- Post Card -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <Label fx:id="titleLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Par" style="-fx-text-fill: #95a5a6;"/>
                <Label fx:id="authorLabel" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            </HBox>

            <Label fx:id="contentLabel" wrapText="true" style="-fx-font-size: 15; -fx-line-spacing: 5; -fx-text-fill: #5d6d6e;"/>
            
            <Separator opacity="0.1"/>

            <!-- Action Buttons Row -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="likeBtn" onAction="#handleLikePost" style="-fx-background-color: white; -fx-border-color: #dcd8d0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;">
                    <graphic>
                        <Label text="♥ J'aime" style="-fx-font-size: 13px; -fx-text-fill: #34495e;"/>
                    </graphic>
                </Button>
                
                <Label fx:id="likesLabel" text="0 j'aime" style="-fx-padding: 8 20; -fx-background-color: #f8f9fa; -fx-border-color: #dcd8d0; -fx-border-radius: 20; -fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
                
                <Button onAction="#handleFocusComment" style="-fx-background-color: white; -fx-border-color: #dcd8d0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="5" alignment="CENTER">
                            <Label text="💬" style="-fx-font-size: 14px;"/>
                            <Label text="Commenter" style="-fx-font-size: 13px; -fx-text-fill: #34495e;"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="saveBtn" onAction="#handleSavePost" style="-fx-background-color: white; -fx-border-color: #dcd8d0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;">
                    <graphic>
                        <Label text="☆ Enregistrer" style="-fx-font-size: 13px; -fx-text-fill: #34495e;"/>
                    </graphic>
                </Button>

                <Button fx:id="editPostBtn" onAction="#handleEditPost" style="-fx-background-color: white; -fx-border-color: #dcd8d0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;">
                    <graphic>
                        <Label text="✎ Modifier" style="-fx-font-size: 13px; -fx-text-fill: #f39c12;"/>
                    </graphic>
                </Button>

                <Button fx:id="deletePostBtn" onAction="#handleDeletePost" style="-fx-background-color: white; -fx-border-color: #dcd8d0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;">
                    <graphic>
                        <Label text="🗑 Supprimer" style="-fx-font-size: 13px; -fx-text-fill: #95a5a6;"/>
                    </graphic>
                </Button>

                <Button onAction="#handleSignalPost" style="-fx-background-color: white; -fx-border-color: #dcd8d0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;">
                    <graphic>
                        <Label text="🚩 Signaler" style="-fx-font-size: 13px; -fx-text-fill: #e74c3c;"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- Comments Section -->
        <VBox spacing="20">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Commentaires" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
                <Label fx:id="commentCountBadge" text="0" style="-fx-background-color: #ecf0f1; -fx-padding: 2 10; -fx-background-radius: 10; -fx-font-size: 14;"/>
            </HBox>

            <VBox fx:id="commentsContainer" spacing="15"/>
        </VBox>

        <!-- Add Comment Box -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <HBox fx:id="replyIndicator" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false" style="-fx-background-color: #f8f9fa; -fx-padding: 5 10; -fx-background-radius: 5;">
                <Label fx:id="replyLabel" text="Réponse à..." style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                <Button onAction="#handleCancelReply" text="✕" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-cursor: hand; -fx-padding: 0; -fx-font-weight: bold;"/>
            </HBox>
            <TextArea fx:id="commentTextArea" promptText="Votre message..." prefHeight="80" wrapText="true" style="-fx-background-radius: 5; -fx-border-color: #ecf0f1;"/>
            <HBox alignment="CENTER_RIGHT">
                <Button text="Publier" onAction="#handlePublishComment" styleClass="btn-primary" prefWidth="120" prefHeight="35" style="-fx-background-radius: 20;"/>
            </HBox>
        </VBox>

        <Button text="← Retour au forum" onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-cursor: hand;"/>
    </VBox>
</ScrollPane>
