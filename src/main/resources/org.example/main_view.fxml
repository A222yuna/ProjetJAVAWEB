<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <ListView fx:id="messageListView" VBox.vgrow="ALWAYS" />

    <HBox spacing="10.0">
        <TextField fx:id="inputField" HBox.hgrow="ALWAYS" promptText="Tapez votre message ici..." />
        <Button text="Envoyer" onAction="#onSendClicked" />
        <Button text="Rafraîchir" onAction="#loadMessages" />
    </HBox>
</VBox>