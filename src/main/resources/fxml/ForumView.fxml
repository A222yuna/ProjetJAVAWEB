<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.pidev.forum.controllers.ForumController"
            prefHeight="900.0" prefWidth="1400.0"
            style="-fx-background-color: #f1f2f1; -fx-font-family: 'Georgia';">

    <!-- Header - BLUE avec bouton Accueil un peu plus bas -->
    <top>
        <VBox style="-fx-background-color: #2e266d;">
            <!-- Top bar avec bouton Accueil -->
            <!-- Augmenter le padding top pour descendre le bouton -->
            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 25 30 10 30;">
                <Button text="🏠  Accueil" onAction="#handleReturnHome"
                        prefHeight="40" prefWidth="130"
                        style="-fx-background-color: white; -fx-text-fill: #2e266d;
                               -fx-font-family: 'Georgia'; -fx-font-size: 13px;
                               -fx-font-weight: bold; -fx-background-radius: 8;
                               -fx-cursor: hand;"/>
            </HBox>

            <!-- Titre et sous-titre -->
            <VBox style="-fx-padding: 10 40 35 40;">
                <Label text="forum de discussion" textFill="white">
                    <font>
                        <Font name="Georgia" size="44.0"/>
                    </font>
                </Label>
                <Label text="partagez vos expériences dans un espace bienveillant" textFill="white" opacity="0.9">
                    <font>
                        <Font name="Georgia" size="17.0"/>
                    </font>
                    <VBox.margin>
                        <Insets top="8.0"/>
                    </VBox.margin>
                </Label>
            </VBox>
        </VBox>
    </top>

    <!-- Main Content with BLUE Sidebar -->
    <center>
        <HBox spacing="0" style="-fx-background-color: #f1f2f1;">

            <!-- BLUE Sidebar -->
            <VBox prefWidth="280" style="-fx-background-color: #2e266d; -fx-padding: 30 0;">

                <Label text="Catégories" textFill="white"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-font-family: 'Georgia'; -fx-padding: 0 25;">
                    <VBox.margin>
                        <Insets bottom="15"/>
                    </VBox.margin>
                </Label>

                <VBox fx:id="categoriesContainer" spacing="0" style="-fx-background-color: transparent;"/>

                <Separator style="-fx-background-color: rgb(243,240,240);">
                    <VBox.margin>
                        <Insets top="20" bottom="20" left="25" right="25"/>
                    </VBox.margin>
                </Separator>

                <VBox spacing="15" style="-fx-padding: 0 25;">
                    <Label text="🏆 Top Posts"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <VBox fx:id="topPostsContainer" spacing="8"/>
                </VBox>

                <VBox spacing="12" style="-fx-padding: 0 25;">
                    <Label text="Actions" textFill="white"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Georgia';"/>

                    <Button text="🔄 Actualiser" onAction="#handleRefresh" prefWidth="230" prefHeight="45"
                            style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-font-size: 15px; -fx-font-family: 'Georgia';
                                   -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.4);
                                   -fx-border-width: 1.5; -fx-border-radius: 8;"/>
                </VBox>
            </VBox>

            <!-- Main Content Area -->
            <VBox HBox.hgrow="ALWAYS" spacing="25" style="-fx-background-color: #f1f2f1;">
                <padding>
                    <Insets top="30.0" right="50.0" bottom="25.0" left="50.0"/>
                </padding>

                <!-- Search Bar -->
                <HBox spacing="15.0" alignment="CENTER_LEFT" maxWidth="1100">

                    <TextField fx:id="searchField" promptText="rechercher..."
                               prefWidth="500.0" prefHeight="50.0" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: white; -fx-background-radius: 10;
                                     -fx-border-color: #d0d0d0; -fx-border-width: 1; -fx-border-radius: 10;
                                     -fx-padding: 0 18; -fx-font-size: 15px; -fx-font-family: 'Georgia';"/>

                    <Button text="rechercher" onAction="#handleSearch" prefHeight="50.0" prefWidth="140"
                            style="-fx-background-color: #193764; -fx-text-fill: white; -fx-background-radius: 10;
                                   -fx-font-size: 15px; -fx-font-family: 'Georgia'; -fx-cursor: hand;"/>

                    <ComboBox fx:id="categoryComboBox" prefWidth="230.0" prefHeight="50.0"
                              onAction="#handleCategoryFilter" promptText="Toutes les catégories"
                              style="-fx-background-color: #193764; -fx-text-fill: white; -fx-background-radius: 10;
                                     -fx-font-size: 14px; -fx-font-family: 'Georgia';"/>

                    <Button text="+ Post" onAction="#handleNewPost" prefHeight="50.0" prefWidth="120"
                            style="-fx-background-color: #193764; -fx-text-fill: white; -fx-background-radius: 10;
                                   -fx-font-size: 16px; -fx-font-family: 'Georgia'; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <!-- Posts Feed -->
                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-background: transparent;"
                            VBox.vgrow="ALWAYS">
                    <VBox alignment="TOP_CENTER" style="-fx-background-color: transparent;">
                        <VBox fx:id="postsContainer" spacing="18.0" maxWidth="1100"
                              style="-fx-background-color: transparent;"/>
                    </VBox>
                </ScrollPane>
            </VBox>
        </HBox>
    </center>

</BorderPane>
