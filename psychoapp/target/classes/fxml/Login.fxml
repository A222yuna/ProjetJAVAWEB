<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.psychoapp.controller.LoginController"
      alignment="CENTER" spacing="0"
      style="-fx-background-color: #f0f4f8;">

    <!-- Card -->
    <VBox alignment="CENTER" spacing="18" maxWidth="340"
          style="-fx-background-color: white; -fx-background-radius: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);">
        <padding><Insets top="40" right="36" bottom="36" left="36"/></padding>

        <!-- Logo / Title -->
        <Label text="🧠" style="-fx-font-size: 44px;"/>
        <Label text="PsychoApp" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
        <Label text="Connectez-vous à votre compte"
               style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>

        <Separator/>

        <!-- Email -->
        <VBox spacing="5">
            <Label text="Email" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;"/>
            <TextField fx:id="fieldEmail" promptText="vous@exemple.com"
                       style="-fx-pref-width: 268;"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="5">
            <Label text="Mot de passe" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;"/>
            <PasswordField fx:id="fieldPassword" promptText="••••••••"
                           style="-fx-pref-width: 268;"/>
        </VBox>

        <!-- Error -->
        <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="268"
               style="-fx-text-fill: #e53e3e; -fx-font-size: 12px;"/>

        <!-- Login Button -->
        <Button text="Se connecter" onAction="#handleLogin"
                maxWidth="Infinity" styleClass="btn-primary"
                style="-fx-pref-height: 40px; -fx-font-size: 14px;"/>

        <Separator/>

        <!-- Switch to Register -->
        <HBox alignment="CENTER" spacing="6">
            <Label text="Pas encore de compte ?"
                   style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
            <Hyperlink text="S'inscrire" onAction="#handleGoRegister"
                       style="-fx-text-fill: #4299e1; -fx-font-size: 13px;"/>
        </HBox>
    </VBox>
</VBox>
