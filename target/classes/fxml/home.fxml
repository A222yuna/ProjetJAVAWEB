<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.psy.gestioncabinet.controller.HomeController"
      spacing="20" alignment="CENTER">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Plateforme Psychologie"
           style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

    <Label text="Choisissez votre espace"
           style="-fx-font-size: 16px; -fx-text-fill: #555;"/>

    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="btnAdmin"
                text="Espace Admin"
                style="-fx-min-width: 150; -fx-min-height: 60;"/>

        <Button fx:id="btnPsychologue"
                text="Espace Psychologue"
                style="-fx-min-width: 150; -fx-min-height: 60;"/>

        <Button fx:id="btnPatient"
                text="Espace Patient"
                style="-fx-min-width: 150; -fx-min-height: 60;"/>
    </HBox>

</VBox>

