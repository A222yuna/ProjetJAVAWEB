<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.psy.gestioncabinet.controller.PsychologueDashboardController"
            styleClass="dashboard-root">
    
    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="24">
            <VBox styleClass="sidebar-header">
                <Label text="MindConnect" styleClass="sidebar-app-name"/>
                <Label text="Psychologue" styleClass="sidebar-role"/>
            </VBox>

            <VBox styleClass="sidebar-footer">
                <VBox styleClass="sidebar-user-box">
                    <Label fx:id="lblWelcome" text="Dr. Psychologue" styleClass="sidebar-user-name"/>
                    <Label text="Psychologue" styleClass="sidebar-user-role-text"/>
                </VBox>
                <Button fx:id="btnDeconnexion" text="Déconnexion" styleClass="btn-logout"/>
            </VBox>
        </VBox>
    </left>
    
    <!-- Main Content -->
    <center>
        <VBox fx:id="rootContent" styleClass="main-content" spacing="18">
            <!-- Header text above welcome card -->
            <VBox styleClass="content-header">
                <Label text="Mes Cabinets" styleClass="content-title"/>
                <Label text="Gérez vos cabinets psychologiques" styleClass="content-subtitle"/>
            </VBox>

            <!-- Welcome Card -->
            <VBox styleClass="welcome-card" spacing="4">
                <Label fx:id="lblWelcomeCard" text="Bonjour, Dr. ..." styleClass="welcome-title"/>
                <Label text="Gérez vos cabinets et suivez leur statut de validation." styleClass="welcome-subtitle"/>
            </VBox>

            <!-- Stats -->
            <GridPane styleClass="stats-grid" hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                </columnConstraints>

                <VBox styleClass="stat-card" spacing="4" GridPane.columnIndex="0">
                    <Label text="Total Cabinets" styleClass="stat-label"/>
                    <Label fx:id="lblTotalCabinets" text="0" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="4" GridPane.columnIndex="1">
                    <Label text="Cabinets Validés" styleClass="stat-label"/>
                    <Label fx:id="lblCabinetsValides" text="0" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="4" GridPane.columnIndex="2">
                    <Label text="En Attente" styleClass="stat-label"/>
                    <Label fx:id="lblCabinetsEnAttente" text="0" styleClass="stat-value"/>
                </VBox>
            </GridPane>

            <!-- Actions -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Mes Cabinets" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAjouter" text="+ Ajouter" styleClass="btn-add"/>
                <Button fx:id="btnModifier" text="Modifier" styleClass="btn-edit"/>
                <Button fx:id="btnPlanifier" text="Planifier créneaux" styleClass="btn-edit"/>
                <Button fx:id="btnSupprimer" text="Supprimer" styleClass="btn-delete"/>
            </HBox>

            <!-- Table -->
            <VBox spacing="6" styleClass="table-container">
                <Label text="Liste de mes cabinets" styleClass="subsection-title"/>
                <TableView fx:id="tableCabinets" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                        <TableColumn fx:id="colAdresse" text="Adresse" prefWidth="300"/>
                        <TableColumn fx:id="colVille" text="Ville" prefWidth="150"/>
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
