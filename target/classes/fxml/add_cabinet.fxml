<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.psy.gestioncabinet.controller.AddCabinetController"
      spacing="15" styleClass="form-dialog">
    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Ajouter un cabinet" styleClass="dialog-title"/>

    <Label text="Adresse *" styleClass="field-label"/>
    <TextField fx:id="tfAdresse" promptText="Ex: Tunisia, Mednine 4100" styleClass="input-field"/>

    <Label text="Ville *" styleClass="field-label"/>
    <TextField fx:id="tfVille" promptText="Ex: Tunis" styleClass="input-field"/>

    <Label text="Horaires" styleClass="field-label"/>
    <TextField fx:id="tfHoraires" promptText="Ex: 10 17 ou LUN Ven 10 17" styleClass="input-field"/>

    <Label text="Description" styleClass="field-label"/>
    <TextArea fx:id="taDescription" promptText="Description du cabinet..." wrapText="true" prefRowCount="3" styleClass="input-area"/>

    <Label fx:id="lblError" styleClass="error-label" visible="false" wrapText="true"/>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="btnValider" text="Valider" styleClass="btn-primary"/>
        <Button fx:id="btnAnnuler" text="Annuler" styleClass="btn-secondary"/>
    </HBox>
</VBox>
