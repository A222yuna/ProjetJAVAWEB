<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.psychologie.controller.admin.AdminAppointmentController"
      style="-fx-background-color: #f4f2ee;">

    <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT">
        <Label text="Administration" styleClass="label-header" style="-fx-font-size: 18;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="dateLabel" styleClass="stat-label-admin"/>
    </HBox>

    <Label text="Vue globale des rendez-vous"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1c2824;"/>

    <!-- Stat cards -->
    <HBox spacing="16">
        <VBox styleClass="stat-card-admin" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="ÉLÉMENTS PAGE" styleClass="stat-label-admin"/>
            <Label fx:id="totalLabel" text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>
        <VBox styleClass="stat-card-admin" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="FILTRE STATUT" styleClass="stat-label-admin"/>
            <Label text="Tous"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>
        <VBox styleClass="stat-card-admin" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="PAGE" styleClass="stat-label-admin"/>
            <Label text="1/1"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>
        <VBox styleClass="stat-card-admin" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="WORKFLOW" styleClass="stat-label-admin"/>
            <Label text="SCHEDULED → COMPLETED"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>
    </HBox>

    <!-- Filters -->
    <HBox spacing="14" alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label text="Statut" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
            <ComboBox fx:id="statusFilter" prefWidth="130" prefHeight="34"
                      onAction="#applyFilters"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Date" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
            <DatePicker fx:id="datePicker" prefWidth="160" prefHeight="34"
                        promptText="jj/mm/aaaa"/>
        </VBox>
        <Button text="Filtrer" onAction="#applyFilters"
                style="-fx-background-color:#3498db; -fx-text-fill:white;
                       -fx-background-radius:6; -fx-cursor:hand;
                       -fx-padding:8 18; -fx-translate-y:10;"/>
        <Button text="Réinitialiser" onAction="#handleReset"
                style="-fx-background-color:white; -fx-border-color:#dee2e6;
                       -fx-background-radius:6; -fx-cursor:hand;
                       -fx-padding:8 18; -fx-translate-y:10;"/>
    </HBox>

    <!-- Table -->
    <VBox styleClass="stat-card-admin" VBox.vgrow="ALWAYS" style="-fx-padding:0;">
        <TableView fx:id="appointmentTable" VBox.vgrow="ALWAYS"
                   style="-fx-background-color:transparent;">
            <columns>
                <TableColumn fx:id="idColumn"      text="ID"           prefWidth="60"/>
                <TableColumn fx:id="patientColumn" text="Patient"      prefWidth="180"/>
                <TableColumn fx:id="psyColumn"     text="Psychologue"  prefWidth="180"/>
                <TableColumn fx:id="dateColumn"    text="Date"         prefWidth="110"/>
                <TableColumn fx:id="statusColumn"  text="Statut"       prefWidth="120"/>
                <TableColumn fx:id="actionsColumn" text="Actions"      prefWidth="280"/>
            </columns>
            <placeholder>
                <Label text="Aucun rendez-vous trouvé."
                       style="-fx-text-fill:#5a6560; -fx-padding:20;"/>
            </placeholder>
        </TableView>
    </VBox>

</VBox>
