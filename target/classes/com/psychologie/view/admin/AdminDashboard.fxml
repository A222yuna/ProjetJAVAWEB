<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.psychologie.controller.admin.AdminDashboardController"
            style="-fx-background-color: #f4f2ee; -fx-background: #f4f2ee;">
    
    <VBox spacing="25">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Tableau de Bord Administrateur" styleClass="label-header" style="-fx-font-size: 20;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="dateLabel" text="10 May 2026" styleClass="stat-label-admin"/>
        </HBox>

        <!-- Stat Cards Row -->
        <HBox spacing="20">
            <HBox styleClass="stat-card-admin" HBox.hgrow="ALWAYS" spacing="15" alignment="CENTER_LEFT">
                <StackPane style="-fx-background-color: #ebf5fb; -fx-padding: 15; -fx-background-radius: 10;">
                    <Label text="👥" style="-fx-font-size: 24;"/>
                </StackPane>
                <VBox spacing="5">
                    <Label text="UTILISATEURS" styleClass="stat-label-admin"/>
                    <Label fx:id="userCountLabel" text="8" styleClass="stat-value-admin" style="-fx-text-fill: #2c3e50;"/>
                </VBox>
            </HBox>

            <HBox styleClass="stat-card-admin" HBox.hgrow="ALWAYS" spacing="15" alignment="CENTER_LEFT">
                <StackPane style="-fx-background-color: #e8f8f5; -fx-padding: 15; -fx-background-radius: 10;">
                    <Label text="📅" style="-fx-font-size: 24;"/>
                </StackPane>
                <VBox spacing="5">
                    <Label text="RENDEZ-VOUS" styleClass="stat-label-admin"/>
                    <Label fx:id="appointmentCountLabel" text="6" styleClass="stat-value-admin" style="-fx-text-fill: #2c3e50;"/>
                </VBox>
            </HBox>

            <HBox styleClass="stat-card-admin" HBox.hgrow="ALWAYS" spacing="15" alignment="CENTER_LEFT">
                <StackPane style="-fx-background-color: #fef9e7; -fx-padding: 15; -fx-background-radius: 10;">
                    <Label text="🏢" style="-fx-font-size: 24;"/>
                </StackPane>
                <VBox spacing="5">
                    <Label text="CABINETS À VALIDER" styleClass="stat-label-admin"/>
                    <Label fx:id="cabinetCountLabel" text="1" styleClass="stat-value-admin" style="-fx-text-fill: #2c3e50;"/>
                </VBox>
            </HBox>
        </HBox>

        <HBox spacing="20">
            <!-- Left Overview Section -->
            <VBox spacing="20" styleClass="stat-card-admin" HBox.hgrow="ALWAYS" style="-fx-padding: 25;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📈 Vue d'ensemble" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #3498db;"/>
                </HBox>
                
                <VBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #ecf0f1; -fx-border-radius: 10;">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="ℹ" style="-fx-font-size: 20; -fx-text-fill: #3498db;"/>
                        <VBox>
                            <Label text="Bienvenue dans votre espace d'administration." style="-fx-font-weight: bold;"/>
                            <Label text="Vous pouvez gérer les utilisateurs, valider les cabinets et superviser les rendez-vous." style="-fx-text-fill: #7f8c8d; -fx-font-size: 12;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <Label text="MODULES PRINCIPAUX" styleClass="stat-label-admin" style="-fx-font-size: 11;"/>
                
                <VBox spacing="10">
                    <!-- Manage Users Module -->
                    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #f8f9fa; -fx-padding: 12; -fx-background-radius: 8;">
                        <Label text="👤" style="-fx-font-size: 18; -fx-text-fill: #3498db;"/>
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Gestion des comptes" style="-fx-font-weight: bold;"/>
                            <Label text="Activation et modération des profils." style="-fx-text-fill: #95a5a6; -fx-font-size: 11;"/>
                        </VBox>
                        <Button text="Gérer" onAction="#handleManageUsers" style="-fx-background-color: white; -fx-border-color: #dcd8d0; -fx-border-radius: 15; -fx-background-radius: 15; -fx-font-size: 11; -fx-padding: 5 15; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Consultations Module -->
                    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #f8f9fa; -fx-padding: 12; -fx-background-radius: 8;">
                        <Label text="📅" style="-fx-font-size: 18; -fx-text-fill: #27ae60;"/>
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Consultations" style="-fx-font-weight: bold;"/>
                            <Label text="Supervision globale de l'activité." style="-fx-text-fill: #95a5a6; -fx-font-size: 11;"/>
                        </VBox>
                        <Button text="Voir" onAction="#handleViewConsultations" style="-fx-background-color: white; -fx-border-color: #dcd8d0; -fx-border-radius: 15; -fx-background-radius: 15; -fx-font-size: 11; -fx-padding: 5 15; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Right Sidebar Actions -->
            <VBox spacing="20" prefWidth="300">
                <VBox spacing="15" styleClass="stat-card-admin" style="-fx-padding: 20;">
                    <Label text="Actions Rapides" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                    <Button text="⊕ Nouveau Psychologue" onAction="#handleNewPsychologue" maxWidth="Infinity" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button text="💬 Voir le Forum" onAction="#handleViewForum" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #2c3e50; -fx-text-fill: #2c3e50; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </VBox>

                <VBox spacing="15" styleClass="stat-card-admin" style="-fx-padding: 20;">
                    <Label text="DERNIÈRES ALERTES" styleClass="stat-label-admin" style="-fx-font-size: 11;"/>
                    
                    <VBox spacing="15">
                        <HBox spacing="10" alignment="TOP_LEFT">
                            <Circle radius="5" fill="#e74c3c" style="-fx-translate-y: 5;"/>
                            <VBox>
                                <Label text="Nouveau signalement" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                                <Label text="Signalement sur le forum à vérifier." style="-fx-text-fill: #95a5a6; -fx-font-size: 11;" wrapText="true"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10" alignment="TOP_LEFT">
                            <Circle radius="5" fill="#f1c40f" style="-fx-translate-y: 5;"/>
                            <VBox>
                                <Label text="Cabinet en attente" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                                <Label text="Le cabinet &quot;Psy Zen&quot; attend validation." style="-fx-text-fill: #95a5a6; -fx-font-size: 11;" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
